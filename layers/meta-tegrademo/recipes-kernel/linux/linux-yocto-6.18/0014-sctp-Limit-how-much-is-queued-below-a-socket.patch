 include/net/netns/sctp.h               |   5 ++
 include/net/sctp/structs.h             |  10 +++
 net/sctp/offload.c                     |  14 +++
 net/sctp/output.c                      |   1 +
 net/sctp/outqueue.c                    | 120 ++++++++++++++++++++++++-
 net/sctp/socket.c                      |   6 ++
 net/sctp/sysctl.c                      |   9 ++
 8 files changed, 178 insertions(+), 1 deletion(-)

diff --git a/Documentation/networking/ip-sysctl.rst b/Documentation/networking/ip-sysctl.rst
index 27a861053b2f..e5077a16dfa2 100644
--- a/Documentation/networking/ip-sysctl.rst
+++ b/Documentation/networking/ip-sysctl.rst
@@ -3716,6 +3716,20 @@ l3mdev_accept - BOOLEAN
 
 	Default: 1 (enabled)
 
+limit_output_bytes - INTEGER
+	Controls the SCTP small queue limit per socket, like
+	tcp_limit_output_bytes.  SCTP finds out how much is queued below it
+	only through the RTT, so without losses it queues up to a whole
+	congestion window in the qdisc and device, and can't take any of it
+	back.  Stream priorities and new messages then wait behind all of it.
+	Once a socket has this many bytes (by skb->truesize) on the qdisc or
+	device, its new data stays in the stream scheduler until half of them
+	have been sent.
+
+	0 disables the limit.
+
+	Default: 0
+
 
 ``/proc/sys/net/core/*``
 ========================
