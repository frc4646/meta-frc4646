+/* TX small queues.
+ *
+ * SCTP only finds out how much is queued below it through the RTT, so without
+ * loss it will queue up to a whole cwnd or a large part of a message in the
+ * qdisc and device.  It can't take anything back from there, which means stream
+ * priorities and fresh messages wait behind all of it.  Limit how much is queued
+ * below us, and leave the rest in the stream scheduler.  The limit is on
+ * skb->truesize, like TCP's.
+ */
+enum {
+	SCTP_TSQ_THROTTLED,
+	SCTP_TSQ_QUEUED,
+	SCTP_TSQ_DEFERRED,
+};
+
+static int sctp_limit_output_bytes(const struct sock *sk)
+{
+	return READ_ONCE(sock_net(sk)->sctp.limit_output_bytes);
+}
+
+bool sctp_tsq_throttled(struct sock *sk)
+{
+	struct sctp_sock *sp = sctp_sk(sk);
+	int limit = sctp_limit_output_bytes(sk);
+
+	if (!limit || atomic_read(&sp->tx_bytes) <= limit)
+		return false;
+
+	/* The wakeup has to work after close, when the only thing keeping the
+	 * endpoint around might be this.
+	 */
+	if (!test_and_set_bit(SCTP_TSQ_THROTTLED, &sp->tsq_flags))
+		sctp_endpoint_hold(sp->ep);
+	/* TX completion may have happened before we set the bit. */
+	smp_mb__after_atomic();
+	if (atomic_read(&sp->tx_bytes) > limit)
+		return true;
+
+	if (test_and_clear_bit(SCTP_TSQ_THROTTLED, &sp->tsq_flags))
+		sctp_endpoint_put(sp->ep);
+	return false;
+}
+
+void sctp_tsq_wfree(struct sk_buff *skb)
+{
+	struct sock *sk = skb->sk;
+	struct sctp_sock *sp = sctp_sk(sk);
+	int bytes = atomic_sub_return(skb->truesize, &sp->tx_bytes);
+
+	/* Wait until half of it is gone, to not wake up for every packet. */
+	if (test_bit(SCTP_TSQ_THROTTLED, &sp->tsq_flags) &&
+	    bytes <= sctp_limit_output_bytes(sk) / 2 &&
+	    !test_and_set_bit(SCTP_TSQ_QUEUED, &sp->tsq_flags)) {
+		/* The skb only keeps the memory around, and the socket might
+		 * be going away.
+		 */
+		if (refcount_inc_not_zero(&sk->sk_refcnt))
+			queue_work(system_bh_highpri_wq, &sp->tsq_work);
+		else
+			clear_bit(SCTP_TSQ_QUEUED, &sp->tsq_flags);
+	}
+
+	sock_wfree(skb);
+}
+
+/* Called with skb's size final, right before sending it. */
+void sctp_tsq_charge(struct sk_buff *skb)
+{
+	if (!sctp_limit_output_bytes(skb->sk))
+		return;
+
+	atomic_add(skb->truesize, &sctp_sk(skb->sk)->tx_bytes);
+	skb->destructor = sctp_tsq_wfree;
+}
+
+static void sctp_tsq_write(struct sock *sk)
+{
+	struct sctp_endpoint *ep = sctp_sk(sk)->ep;
+	struct sctp_association *asoc;
+
+	/* Whoever clears the bit owns the reference which keeps ep alive. */
+	if (!test_and_clear_bit(SCTP_TSQ_THROTTLED, &sctp_sk(sk)->tsq_flags))
+		return;
+
+	/* The limit is per socket, and the first association to get a turn can
+	 * use all of it.  Take turns going first.
+	 */
+	list_rotate_left(&ep->asocs);
+	list_for_each_entry(asoc, &ep->asocs, asocs)
+		sctp_outq_uncork(&asoc->outqueue, GFP_ATOMIC);
+
+	sctp_endpoint_put(ep);
+}
+
+void sctp_tsq_work(struct work_struct *work)
+{
+	struct sctp_sock *sp = container_of(work, struct sctp_sock, tsq_work);
+	struct sock *sk = &sp->inet.sk;
+
+	clear_bit(SCTP_TSQ_QUEUED, &sp->tsq_flags);
+
+	bh_lock_sock(sk);
+	if (sock_owned_by_user(sk))
+		set_bit(SCTP_TSQ_DEFERRED, &sp->tsq_flags);
+	else
+		sctp_tsq_write(sk);
+	bh_unlock_sock(sk);
+	sock_put(sk);
+}
+
+void sctp_tsq_release_cb(struct sock *sk)
+{
+	if (test_and_clear_bit(SCTP_TSQ_DEFERRED, &sctp_sk(sk)->tsq_flags))
+		sctp_tsq_write(sk);
+}
+
 /* Try to flush an outqueue.
  *
  * Description: Send everything in q which we legally can, subject to
