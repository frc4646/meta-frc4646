From: Austin Schuh <austin.linux@gmail.com>
Date: Wed, 14 Oct 2026 21:45:00 -0700
Subject: [PATCH] firmware: tegra: bpmp: populate debugfs in the background

On Tegra234, mirroring the BPMP's debugfs tree into debugfs takes 5.2
seconds at boot: the tree has about 10,800 entries, and each directory
takes several BPMP requests.  The BPMP probe waits for it, and so does
every device which depends on the BPMP for clocks, resets or power,
which is most of them.  PCIe, NVMe and the root filesystem all start
5 seconds later than they need to.

Nothing in the kernel uses the mirror, and the probe already ignores
any error from it, so build it from a workqueue instead.

Measured with initcall_debug on an Orin Nano: the BPMP probe goes from
6.36 seconds to about 1.2 seconds.

Upstream-Status: Pending
Signed-off-by: Austin Schuh <austin.linux@gmail.com>
---
--- a/drivers/firmware/tegra/bpmp.c
+++ b/drivers/firmware/tegra/bpmp.c
@@ -11,6 +11,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm.h>
 #include <linux/semaphore.h>
+#include <linux/workqueue.h>
 #include <linux/sched/clock.h>
 
 #include <soc/tegra/bpmp.h>
@@ -710,8 +711,26 @@
 	spin_unlock(&bpmp->lock);
 }
 
+struct tegra_bpmp_debugfs_work {
+	struct work_struct work;
+	struct tegra_bpmp *bpmp;
+};
+
+static void tegra_bpmp_debugfs_work_fn(struct work_struct *work)
+{
+	struct tegra_bpmp_debugfs_work *dw =
+		container_of(work, struct tegra_bpmp_debugfs_work, work);
+	int err;
+
+	err = tegra_bpmp_init_debugfs(dw->bpmp);
+	if (err < 0)
+		dev_err(dw->bpmp->dev, "debugfs initialization failed: %d\n",
+			err);
+}
+
 static int tegra_bpmp_probe(struct platform_device *pdev)
 {
+	struct tegra_bpmp_debugfs_work *debugfs_work;
 	struct tegra_bpmp *bpmp;
 	char tag[TAG_SZ];
 	size_t size;
@@ -804,10 +823,21 @@
 			goto free_mrq;
 	}
 
+	/*
+	 * Mirroring the BPMP's debugfs tree takes several requests per
+	 * directory, and on Tegra234 that is several seconds.  Nothing else
+	 * waits for it, so do it in the background rather than hold up every
+	 * device that depends on the BPMP.
+	 */
 	if (tegra_sku_info.platform != TEGRA_PLATFORM_VDK) {
-		err = tegra_bpmp_init_debugfs(bpmp);
-		if (err < 0)
-			dev_err(&pdev->dev, "debugfs initialization failed: %d\n", err);
+		debugfs_work = devm_kzalloc(&pdev->dev, sizeof(*debugfs_work),
+					    GFP_KERNEL);
+		if (debugfs_work) {
+			debugfs_work->bpmp = bpmp;
+			INIT_WORK(&debugfs_work->work,
+				  tegra_bpmp_debugfs_work_fn);
+			queue_work(system_unbound_wq, &debugfs_work->work);
+		}
 	}
 
 	return 0;
