From be15477416503b00eb1aceca449ce63fec9ba7af Mon Sep 17 00:00:00 2001
From: Austin Schuh <austin.linux@gmail.com>
Date: Wed, 14 Oct 2026 00:34:22 -0700
Subject: [PATCH] io_uring: wake real-time waiters from hard interrupt context
 on PREEMPT_RT

On PREEMPT_RT, an hrtimer that is not marked HRTIMER_MODE_HARD expires in
the per-CPU ktimers thread, which runs at SCHED_FIFO 1.  A SCHED_FIFO task
waiting in io_uring_enter() with a timeout is therefore not woken at its
deadline if any other real-time task is running on its CPU: the wakeup
waits until every runnable real-time task there has blocked.

hrtimer sleepers avoid this by marking the timer hard when the sleeping
task is in a real-time or deadline class (__hrtimer_setup_sleeper()), and
the ktimers thread was introduced on the premise that wakeups of real-time
tasks happen from hard interrupt context.  The CQ wait timer is a sleeper in
all but name: io_cqring_timer_wakeup() sets a flag and calls
wake_up_process(), and io_cqring_min_timer_wakeup() only reads the rings
before doing the same or re-arming.  Both are safe in hard interrupt
context.  Apply the sleeper rule to it.

Measured on a Jetson Orin Nano (6.18.39-rt, unpatched) with a SCHED_FIFO 40
waiter and a SCHED_FIFO 20 thread running bursts of up to 1 ms on the same
CPU, 40,000 deadlines 500 us apart: io_uring_wait_cqe_timeout() woke more
than 100 us late 6,647 times, at worst 1,040 us, and 2,758 deadlines passed
without a wakeup; clock_nanosleep() and epoll_pwait2() on the same setup
were never more than 19 us late.

Upstream-Status: Pending
---
 io_uring/io_uring.c | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/io_uring/io_uring.c b/io_uring/io_uring.c
index 7f398c4a3a6e..a938ea85f1fb 100644
--- a/io_uring/io_uring.c
+++ b/io_uring/io_uring.c
@@ -60,6 +60,7 @@
 #include <net/sock.h>
 #include <linux/anon_inodes.h>
 #include <linux/sched/mm.h>
+#include <linux/sched/rt.h>
 #include <linux/uaccess.h>
 #include <linux/nospec.h>
 #include <linux/fsnotify.h>
@@ -2595,23 +2596,40 @@ static enum hrtimer_restart io_cqring_min_timer_wakeup(struct hrtimer *timer)
 	return io_cqring_timer_wakeup(timer);
 }
 
+/*
+ * On PREEMPT_RT, an hrtimer that is not marked for hard interrupt expiry
+ * expires in the ktimers thread, at the lowest SCHED_FIFO priority, so a
+ * real-time task waiting on it is not woken until every runnable real-time
+ * task on its CPU has blocked.  hrtimer sleepers of real-time tasks are
+ * marked hard for that reason (__hrtimer_setup_sleeper()).  This timer is a
+ * sleeper in all but name: both callbacks only look at the ring and wake the
+ * waiter, which is safe in hard interrupt context.  Apply the same rule.
+ */
+static enum hrtimer_mode io_cqring_timer_mode(void)
+{
+	if (IS_ENABLED(CONFIG_PREEMPT_RT) && rt_or_dl_task_policy(current))
+		return HRTIMER_MODE_ABS_HARD;
+	return HRTIMER_MODE_ABS;
+}
+
 static int io_cqring_schedule_timeout(struct io_wait_queue *iowq,
 				      clockid_t clock_id, ktime_t start_time)
 {
+	const enum hrtimer_mode mode = io_cqring_timer_mode();
 	ktime_t timeout;
 
 	if (iowq->min_timeout) {
 		timeout = ktime_add_ns(iowq->min_timeout, start_time);
 		hrtimer_setup_on_stack(&iowq->t, io_cqring_min_timer_wakeup, clock_id,
-				       HRTIMER_MODE_ABS);
+				       mode);
 	} else {
 		timeout = iowq->timeout;
 		hrtimer_setup_on_stack(&iowq->t, io_cqring_timer_wakeup, clock_id,
-				       HRTIMER_MODE_ABS);
+				       mode);
 	}
 
 	hrtimer_set_expires_range_ns(&iowq->t, timeout, 0);
-	hrtimer_start_expires(&iowq->t, HRTIMER_MODE_ABS);
+	hrtimer_start_expires(&iowq->t, mode);
 
 	if (!READ_ONCE(iowq->hit_timeout))
 		schedule();
-- 
