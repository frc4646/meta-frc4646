[Match]
Name=eth0

[Network]
Address=10.18.68.101/24
Gateway=10.18.68.4
DNS=8.8.8.8

# ipv6 adds an extra 10 seconds to boot, and we don't use it...
# Disable all the route discovery and stuff
LinkLocalAddressing=no

# Pin the root qdisc.  Otherwise it depends on whether sch_fq_codel is loaded
# when the link comes up (pfifo_fast if not, net.core.default_qdisc if so).
# fq_codel's per-flow queues keep SCTP from waiting behind bulk TCP.
[FairQueueingControlledDelay]
Parent=root
